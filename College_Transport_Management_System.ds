	reports
	{
		list transport_registration_Report
		{
			displayName = "All Transport Registrations"
			show all rows from transport_registration    
			(
				registration_id as "Registration ID"
				student as "Student"
				bus as "Bus"
				route as "Route"
				boarding_stop as "Boarding Stop"
				academic_year as "Academic Year"
				registration_date as "Registration Date"
				status as "Registration Status"
				remarks as "Remarks"
				approved_by as "Approved By"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Pending")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban transport_registration_by_status
		{
			displayName = "Registration Statuses"
