				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notification_sent
			(
    			type = checkbox
				displayname = "Notification Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			alert_date
			(
    			type = date
				displayname = "Alert Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Alert Created","Notification Sent","Pending Review","Action Taken","Escalation Required","Alert Closed"}
			}
		}
