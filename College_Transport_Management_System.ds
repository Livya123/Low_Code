 application "College Transport Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form bus_attendance
		{
			displayname = "Bus Attendance"
			success message = "Bus Attendance Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			attendance_id
			(
    			type = text
				displayname = "Attendance ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student
			(
				type = list	
				displayname = "Student"
				values  = student_details.ID
    			displayformat = [student_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			bus
			(
				type = list	
				displayname = "Bus"
				values  = bus_details.ID
    			displayformat = [bus_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			route
			(
				type = list	
				displayname = "Route"
				values  = bus_route_assignment.ID
    			displayformat = [route_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendance_date
			(
    			type = date
				displayname = "Attendance Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendance_status
			(
				type = picklist
				displayname = "Attendance Status"
				values = {"Late","Present","Absent"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			boarding_time
			(
    			type = time
				displayname = "Boarding Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			alighting_time
			(
    			type = time
				displayname = "Alighting Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			verified_by
			(
    			type = text
				displayname = "Verified By"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form bus_details
		{
			displayname = "Bus Details"
			success message = "Bus Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			bus_name
			(
    			type = text
				displayname = "Bus Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique registration_number
			(
    			type = text
				displayname = "Registration Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique bus_number
			(
    			type = text
				displayname = "Bus Number"
    			description
    			[
    				type = help_text
    			 	message = "Unique bus identifier"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have bus_type
			(
				type = picklist
				displayname = "Bus Type"
				values = {"College Bus","Mini Bus"}
				others option = true
    			description
    			[
    				type = help_text
    			 	message = "Select bus type"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			bus_model
			(
    			type = text
				displayname = "Bus Model"
	 			row = 1
	 			column = 1   
				width = medium
			)
			manufacturer
			(
    			type = text
				displayname = "Manufacturer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			manufacturing_year
			(
				type = number
				displayname = "Manufacturing Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_number
			(
    			type = text
				displayname = "Insurance Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_certificate_number
			(
    			type = text
				displayname = "Fitness Certificate Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			bus_status
			(
				type = picklist
				displayname = "Bus Status"
				maxchar = 100
				values = {"Active","Maintenance","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_route
			(
				type = picklist	
				displayname = "Assigned Route"
				values  = bus_route_assignment.ID
    			displayformat = [" - " + route_name + " to " + start_point + end_point]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have total_capacity
			(
				type = number
				displayname = "Total Capacity"
				maxchar = 19
    			description
    			[
    				type = help_text
    			 	message = "Total number of seats"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			available_seats
			(
				type = number
				displayname = "Available Seats"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			driver
			(
				type = list	
				displayname = "Assigned Driver"
				values  = driver_details.ID
    			displayformat = [driver_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			insurance_expiry
			(
    			type = date
				displayname = "Insurance Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_expiry
			(
    			type = date
				displayname = "Fitness Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			permit_expiry
			(
    			type = date
				displayname = "Permit Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			maintenance_status
			(
				type = picklist
				displayname = "Maintenance Status"
				values = {"Active","Retired","Under Maintenance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_inspection
			(
    			type = date
				displayname = "Last Inspection Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
