    				dismiss_alert as "Dismiss False Alert"
    				{
         				type = normal
         				from stage = "Pending Review"
         				to stage = "Alert Closed"
         				before
         				{
         				}
         				after
         				{
         				}
  				}
    				escalate_compliance as "Escalate to Compliance Officer"
    				{
