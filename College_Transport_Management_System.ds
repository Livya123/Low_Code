	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Guardian"
			{
				name = "Guardian"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Monitor student attendance records and boarding times \n"
				ModulePermissions
				{
					bus_attendance
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							bus_attendance_by_attendance_status={"View"}
							bus_attendance_Report={"View"}
						}
					}
					transport_fee_management
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							transport_fee_management_by_payment_mode={"View"}
							transport_fee_management_Report={"View"}
						}
					}
				}
			}
			"Student"
			{
				name = "Student"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit transport registration requests and view assigned bus details \n"
				ModulePermissions
				{
					transport_registration
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							transport_registration_Report={"View"}
							transport_registration_by_status={"View"}
						}
					}
					bus_details
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							bus_details_by_bus_type={"View"}
							bus_details_Report={"View"}
						}
					}
					route_capacity_report
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							route_capacity_report_Report={"View"}
						}
					}
					bus_attendance
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							bus_attendance_by_attendance_status={"View","Edit"}
							bus_attendance_Report={"View","Edit"}
						}
					}
					student_details
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							student_details_Report={"View"}
							student_details_by_department={"View"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


